@model IEnumerable<LojaMVC.Models.Cliente>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.nome_cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.email_cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idade_cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.status_cliente)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.nome_cliente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.email_cliente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.idade_cliente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.status_cliente)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.id_cliente">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.id_cliente">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.id_cliente">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
